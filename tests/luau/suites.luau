--!strict
-- One store and service runtime for the suite; standalone cases stay isolated.
test.suite("shared ECR fixture", function(suite)
    suite.before_all(function()
        test.call("ecr", "CreateRepository", {repositoryName = "shared"})
    end)
    suite.before_each(function()
        test.call("sqs", "CreateQueue", {QueueName = "temporary"})
    end)
    suite.after_each(function()
        local url = test.call("sqs", "GetQueueUrl", {QueueName = "temporary"}).QueueUrl
        test.call("sqs", "DeleteQueue", {QueueUrl = url})
    end)
    suite.after_all(function()
        test.call("ecr", "DeleteRepository", {repositoryName = "shared"})
    end)
    suite.case("describes repository", function()
        test.equal(test.call("ecr", "DescribeRepositories", {repositoryNames = {"shared"}}).repositories[1].repositoryName, "shared")
    end)
    suite.case("lists repository", function()
        test.equal(#test.call("ecr", "DescribeRepositories", {}).repositories, 1)
    end)
end)

test.case("suite state is isolated from standalone cases", function()
    test.equal(#test.call("ecr", "DescribeRepositories", {}).repositories, 0)
    test.expect_error("AWS.SimpleQueueService.NonExistentQueue", function()
        return test.try_call("sqs", "GetQueueUrl", {QueueName = "temporary"})
    end)
end)
