-- Luau type definitions for the roto setup API, for luau-analyze and luau-lsp.
-- Generated by `roto-server --lua-stubs`; do not edit. Reference: docs/lua-api.md.
--
-- Pass it as a definitions file:  luau-analyze --definitions=roto.d.luau setup.lua
-- or, in luau-lsp, `luau-lsp.types.definitionFiles`. Start the script with `--!strict`.

-- --8<-- [start:helpers]
declare extern type RotoNull with end

-- Plain Lua values accepted by `roto.dynamodb.put`: strings, numbers, booleans, `roto.null`,
-- `roto.array` lists and nested tables.
type DynamoValue = string | number | boolean | RotoNull | { DynamoValue } | { [string]: DynamoValue }

type QueueOptions = {
	-- Seconds; overrides `attributes.VisibilityTimeout`.
	visibility_timeout: number?,
	attributes: { [string]: string }?,
	tags: { [string]: string }?,
}
type Queue = { name: string, url: string, arn: string }

type Gsi = {
	name: string,
	-- Hash key attribute.
	hash: string,
	range: string?,
	-- `ALL` (default) or `KEYS_ONLY`.
	projection: ("ALL" | "KEYS_ONLY")?,
}
type TableOptions = {
	-- Hash key attribute.
	hash: string,
	-- Range key attribute; omit for a hash-only table.
	range: string?,
	-- Key attribute types; every key attribute defaults to `S`.
	types: { [string]: "S" | "N" | "B" }?,
	gsis: { Gsi }?,
}
type Table = { name: string, arn: string }

type CorsRule = {
	methods: { string },
	origins: { string },
	headers: { string }?,
	expose: { string }?,
	-- Seconds.
	max_age: number?,
	id: string?,
}
-- An ARN string, or a helper result with an `arn` field such as a `Queue`.
type Destination = string | { arn: string }
-- Exactly one of `queue`, `topic` or `lambda` per entry. Topic destinations are stored but not delivered.
type NotifyEntry = {
	queue: Destination?,
	topic: Destination?,
	lambda: Destination?,
	-- For example `{"s3:ObjectCreated:*"}`.
	events: { string },
	prefix: string?,
	suffix: string?,
	id: string?,
}
type BucketOptions = {
	-- Replaces the CORS configuration; `{}` removes it.
	cors: { CorsRule }?,
	-- Replaces all notifications; `{}` removes them.
	notify: { NotifyEntry }?,
	-- Do not check that queue destinations exist.
	skip_validation: boolean?,
}
type Bucket = { name: string, arn: string }

type ObjectOptions = {
	content_type: string?,
	metadata: { [string]: string }?,
	-- Response headers (`cache-control` or `cache_control`, content-disposition, content-encoding,
	-- content-language, expires, website-redirect-location).
	headers: { [string]: string }?,
}
type ObjectRef = { bucket: string, key: string }
type LinkDirOptions = {
	content_type: string?,
	metadata: { [string]: string }?,
	-- Response headers (`cache-control` or `cache_control`, content-disposition, content-encoding,
	-- content-language, expires, website-redirect-location).
	headers: { [string]: string }?,
	-- Globs; only matching files are linked. Empty or omitted means all.
	include: { string }?,
	-- Globs; matching files are skipped, even if included.
	exclude: { string }?,
}
type LinkedDir = { bucket: string, prefix: string, count: number }

-- Supply exactly one of `command`, `url` or `container`. (One table type rather than a union:
-- the new Luau solver rejects unions of tables that have optional fields.)
type Executor = {
	-- Command executor: nonempty argv; event JSON on stdin, one JSON value on stdout.
	command: { string }?,
	-- Command executor: defaults to the setup script directory.
	cwd: string?,
	-- Command executor.
	env: { [string]: string }?,
	-- HTTP executor.
	url: string?,
	-- HTTP executor.
	headers: { [string]: string }?,
	-- Container executor: local image that already contains the RIE.
	container: string?,
	-- Container executor.
	warm: boolean?,
}

type HookContext = { account_id: string, region: string, request_id: string }
type LambdaContext = HookContext

-- Supply exactly one of `executor` or `handler`.
type FunctionOptions = {
	-- Seconds, 1 to 900. Default 3.
	timeout: number?,
	-- MiB. Default 128.
	memory_size: number?,
	description: string?,
	environment: { [string]: string }?,
	executor: Executor?,
	handler: ((event: any, context: LambdaContext) -> any)?,
}
type Function = { name: string, arn: string }
type EventSourceOptions = {
	-- 1 to 10. Default 10.
	batch_size: number?,
	-- Default true.
	enabled: boolean?,
	-- Default false.
	report_batch_item_failures: boolean?,
}

type WireOptions = {
	headers: { [string]: string }?,
	-- Raw query string without `?`.
	query: string?,
	body: (string | { [string]: any } | { any })?,
}
type WireResponse = { status: number, headers: { [string]: string }, body: string }

type HookRequest = {
	service: string,
	operation: string,
	method: string,
	path: string,
	query: string,
	headers: { [string]: string },
	body: string,
	-- Present when the body parses as JSON.
	input: any?,
}
type HookResponse = {
	-- 100 to 599.
	status: number,
	headers: { [string]: string }?,
	body: string,
}
type MqttWill = { topic: string, qos: number, retain: boolean, payload_base64: string }
type MqttConnect = {
	protocol_version: number,
	client_id: string,
	clean_session: boolean,
	keep_alive: number,
	username: any,
	password: any,
	password_base64: any,
	will: MqttWill?,
}
type MqttRequest = {
	transport: string,
	operation: string,
	path: string,
	query: string,
	headers: { [string]: string },
	source_ip: string,
	source_port: number,
	connection_id: string,
	connect: MqttConnect,
	-- Subscribe only.
	packet_id: number?,
	-- Subscribe only.
	filters: { { topic: string, qos: number } }?,
}
type RdsDataConnectionRequest = { resource_arn: string, secret_arn: string?, database: string? }

declare roto: {
	-- Server version (informational).
	version: string,
	-- Lua API level; bumped only on breaking changes.
	api_version: number,
	-- Current setup account ID; change it with `set_account`.
	account_id: string,
	-- Current setup region; change it with `set_region`.
	region: string,
	-- Use this 12-digit account for later setup calls and force it for every request.
	set_account: (account_id: string) -> (),
	-- Scope later setup calls to this region.
	set_region: (region: string) -> (),
	-- Server base URL.
	endpoint: string,
	-- Values from repeatable `--set KEY=VALUE` flags.
	vars: { [string]: string },
	-- Explicit JSON null.
	null: RotoNull,

	-- Marks and returns `t` as a JSON array (an empty table then encodes as `[]`).
	array: <T>(t: { T }) -> { T },
	-- Decodes a JSON string. Raises on malformed JSON.
	json_decode: (text: string) -> any,
	-- Standard base64 of a string; binary-safe.
	encode_base64: (text: string) -> string,
	-- Decodes standard base64 to a (binary-safe) string. Raises on invalid base64.
	decode_base64: (text: string) -> string,
	-- Sends a raw request to a service's wire handler. Status 400 and above raises. Setup only.
	wire: (service: string, method: string, path: string, options: WireOptions?) -> WireResponse,

	sqs: {
		-- Creates a missing queue or updates an existing one. Setup only.
		queue: (name: string, options: QueueOptions?) -> Queue,
	},
	dynamodb: {
		-- Creates the table if missing (pay-per-request); an existing table is kept as is. Setup only.
		table: (name: string, options: TableOptions) -> Table,
		-- Writes an item given as plain Lua values. Setup only.
		put: (table: string, item: { [string]: DynamoValue }) -> { table: string },
	},
	s3: {
		-- Creates the bucket if missing and applies the options given. Setup only.
		bucket: (name: string, options: BucketOptions?) -> Bucket,
		-- Stores `body` as a new version of `key`, creating the bucket if needed. Setup only.
		put: (bucket: string, key: string, body: string, options: ObjectOptions?) -> ObjectRef,
		-- Registers `key` as a reference to a host file; the body is not copied. Setup only.
		link: (bucket: string, key: string, file: string, options: ObjectOptions?) -> ObjectRef,
		-- Links every regular file below `dir`, recursively, as `prefix` plus the relative path.
		link_dir: (bucket: string, prefix: string, dir: string, options: LinkDirOptions?) -> LinkedDir,
	},
	lambda: {
		-- Creates or updates function metadata and binds its local implementation. Setup only.
		fn: (name: string, options: FunctionOptions) -> Function,
		-- Binds an executor to existing function metadata without changing that metadata.
		bind: (name: string, executor: Executor) -> { name: string },
		-- Creates or updates the SQS event source mapping. Returns the AWS mapping configuration.
		event_source: (queue: Queue | { arn: string }, func: Function | { arn: string }, options: EventSourceOptions?) -> aws_lambda_EventSourceMappingConfiguration,
	},
	hooks: {
		-- Registers a callback for an exact service and operation. Return `nil` for normal
		-- dispatch, or a response to replace it. A later registration replaces the earlier one.
		request: (service: string, operation: string, callback: (request: HookRequest, context: HookContext) -> HookResponse?) -> (),
		-- Return `{ return_code = 0 }` to accept, 1 to 5 to refuse, or `nil` for normal behavior.
		mqtt_connect: (callback: (request: MqttRequest, context: HookContext) -> { return_code: number }?) -> (),
		-- Return `{ return_codes = roto.array(codes) }` with one entry per filter: 0 or 1 grants
		-- up to that QoS, 128 rejects.
		mqtt_subscribe: (callback: (request: MqttRequest, context: HookContext) -> { return_codes: { number } }?) -> (),
		-- Choose the PostgreSQL server for an RDS Data API request: a connection string such as
		-- `postgres://user:pass@localhost:5432/app`, or `nil` to reject the request.
		rds_data_connection: (callback: (request: RdsDataConnectionRequest, context: HookContext) -> string?) -> (),
	},

	-- Typed AWS clients: `roto.aws.s3.PutBucketCors({ ... })` is `roto.call("s3", "PutBucketCors", { ... })`.
	aws: {
--@@AWS_CLIENTS@@
	},
	-- Calls an operation with a boto3-shaped table and returns the decoded, PascalCase response.
	-- Untyped; prefer `roto.aws.<service>.<Operation>`, whose input and output are checked.
	call: (service: string, operation: string, input: { [string]: any }?) -> any,
}
-- --8<-- [end:helpers]

